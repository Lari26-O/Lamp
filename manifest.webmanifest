{
  "id": "./",
  "name": "Lamp — Learn & Remember the Bible",
  "short_name": "Lamp",
  "description": "Read, understand and remember the Bible: reading plans, short lessons, a study Bible, games for kids and a free AI helper.",
  "start_url": "./#/home",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#f8f5ef",
  "theme_color": "#8a3a12",
  "categories": ["education", "books", "lifestyle"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Today’s challenge", "short_name": "Challenge", "url": "./#/challenge", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Continue reading", "short_name": "Read", "url": "./#/read", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Reading plans", "short_name": "Plans", "url": "./#/plans", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Today at a glance", "short_name": "Today", "url": "./#/widget", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ],
  "widgets": [
    { "name": "Today’s challenge", "short_name": "Challenge", "description": "Your daily challenge and streak.", "tag": "challenge",
      "template": "challenge", "ms_ac_template": "widgets/challenge.json", "data": "widgets/data.json", "type": "application/json",
      "auth": false, "update": 3600, "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }],
      "screenshots": [{ "src": "icons/icon-512.png", "sizes": "512x512", "label": "Today’s challenge" }] },
    { "name": "Today’s reading", "short_name": "Reading", "description": "Your reading plan and the verse of the day.", "tag": "reading",
      "template": "reading", "ms_ac_template": "widgets/reading.json", "data": "widgets/data.json", "type": "application/json",
      "auth": false, "update": 3600, "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }],
      "screenshots": [{ "src": "icons/icon-512.png", "sizes": "512x512", "label": "Today’s reading" }] }
  ]
}
